# Cấu hình server điều phối. Chép thành .env khi chạy ở máy; trên VPS dùng deploy/.env (D quản lý).
# Không commit file .env thật.

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Thư mục dữ liệu (/data trên VPS). CSDL mặc định: <DATA_DIR>/db/croc-classroom.sqlite
DATA_DIR=./data
# DB_PATH=./data/db/croc-classroom.sqlite

# IP/CIDR của reverse proxy được tin (Caddy trong mạng Docker), cách nhau bởi dấu phẩy.
# Để trống = không tin X-Forwarded-For.
TRUST_PROXY=

# croc relay: client nhận qua GET /config sau khi đăng nhập.
RELAY_ADDRESS=relay.example.com:9009
RELAY_PASS=doi-mat-khau-nay

# Kiểm tra phản hồi theo schema hợp đồng (nên bật; tắt chỉ khi cần đo hiệu năng).
VALIDATE_RESPONSES=true
BODY_LIMIT_BYTES=8388608

# CHỈ ĐỂ PHÁT TRIỂN: dịch vụ vé GIẢ — bài tự phát hành sau khi tạo mà không truyền file.
# Dùng để A/B thử giao diện khi chưa có VPS worker của D. KHÔNG bật trên VPS thật.
DEV_FAKE_TRANSFERS=false

# Ghi đè giới hạn mặc định (system-design mục 13). Bỏ trống = dùng mặc định.
# LIMIT_MAX_STUDENTS_PER_ASSIGNMENT=100
# LIMIT_MAX_ASSIGNMENT_BYTES=1073741824
# LIMIT_MAX_SUBMISSION_BYTES=209715200
# LIMIT_MAX_MANIFEST_FILES=10000
# LIMIT_VPS_DISTRIBUTION_SLOTS=10
# LIMIT_VPS_TRANSFER_SLOTS=10
# LIMIT_SEEDER_CONCURRENCY_DEFAULT=1
# LIMIT_TICKET_MIN_SECONDS=120
# LIMIT_TICKET_MIN_BYTES_PER_SECOND=102400
# LIMIT_SERVE_ACCEPT_TIMEOUT_SECONDS=5
