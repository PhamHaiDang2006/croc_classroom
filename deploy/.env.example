# Copy to .env and replace all required values before starting the stack.
DOMAIN=
RELAY_HOST=
RELAY_PASS=

# Keep these five ports consecutive.
RELAY_PORT_1=9009
RELAY_PORT_2=9010
RELAY_PORT_3=9011
RELAY_PORT_4=9012
RELAY_PORT_5=9013

# Select a subnet unused by the host and other Docker networks. Only this Caddy
# address is trusted by the server for forwarded client IPs.
CADDY_PROXY_SUBNET=172.30.240.0/24
CADDY_PROXY_IP=172.30.240.2

SERVER_IMAGE=crocpro-server:local
LIMIT_MAX_STUDENTS_PER_ASSIGNMENT=100
LIMIT_MAX_ASSIGNMENT_BYTES=1073741824
LIMIT_MAX_SUBMISSION_BYTES=209715200
LIMIT_VPS_DISTRIBUTION_SLOTS=10
LIMIT_VPS_TRANSFER_SLOTS=10
