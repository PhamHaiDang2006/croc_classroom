# Copy to .env and replace all required values before starting the stack.
DOMAIN=
RELAY_HOST=
RELAY_PASS=

# Keep these five ports consecutive and aligned with RELAY_PORTS.
RELAY_PORT_1=9009
RELAY_PORT_2=9010
RELAY_PORT_3=9011
RELAY_PORT_4=9012
RELAY_PORT_5=9013
RELAY_PORTS=9009,9010,9011,9012,9013

SERVER_IMAGE=crocpro-server:local
MAX_STUDENTS_PER_ASSIGNMENT=100
MAX_ASSIGNMENT_BYTES=1073741824
MAX_SUBMISSION_BYTES=209715200
MAX_RELAY_DOWNLOADS=10
MAX_RELAY_UPLOADS=10
