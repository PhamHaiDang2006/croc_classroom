{
  "name": "@croc-classroom/croc-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bọc croc CLI: gửi, nhận, tiến trình, huỷ, timeout. Engine thật và loopback để kiểm thử.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  }
}
